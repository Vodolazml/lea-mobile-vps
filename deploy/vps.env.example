# VPS bridge environment. Copy to /etc/lea-mobile.env on the VPS.
LEA_MOBILE_SECRET_KEY=CHANGE_ME_GENERATE_DJANGO_SECRET
LEA_MOBILE_HOSTS=YOUR_DOMAIN_OR_IP,127.0.0.1,localhost
LEA_MOBILE_DB=/var/lib/lea-mobile-vps/mobile.sqlite3

# Key used by the local office server when it pulls/confirms packages from VPS
# (management command sync_vps_exchange on the local server, LEA_VPS_EXCHANGE_URL).
LEA_MOBILE_LOCAL_API_KEY=CHANGE_ME_LONG_RANDOM_HEX

# Key used by an office admin to register/revoke a phone's Bearer token hash
# via POST /api/admin/v1/mobile-keys/register/ (see README_VPS.md).
LEA_MOBILE_ADMIN_KEY=CHANGE_ME_LONG_RANDOM_HEX

# IMPORTANT: never set an exchange/payload decryption key on this VPS.
# The VPS must only ever store and forward the encrypted payload blob and
# must never be able to decrypt business data.
